rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isProfessor() {
      return signedIn() && userProfile().data.rol == 'profesor';
    }

    match /usuarios/{userId} {
      allow get: if signedIn() && userId == request.auth.uid;
      allow list: if isProfessor();
      allow create, update: if isProfessor();
      allow delete: if false;
    }

    match /equipos/{teamId} {
      allow read: if isProfessor() || (signedIn() && teamId in userProfile().data.teamIds);
      allow create, update: if isProfessor();
      allow delete: if false;
    }

    match /jugadores/{playerId} {
      allow get: if isProfessor() || (signedIn() && playerId == userProfile().data.playerId);
      allow list: if isProfessor();
      allow create, update: if isProfessor();
      allow delete: if false;
    }

    match /registros/{recordId} {
      allow get: if isProfessor() || (signedIn() && resource.data.playerId == userProfile().data.playerId);
      allow list: if isProfessor() || (signedIn() && resource.data.playerId == userProfile().data.playerId);
      allow create, update: if isProfessor();
      allow delete: if false;
    }
  }
}
